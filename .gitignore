# Local runtime state; retain the empty data directory.
/data/*
!/data/.keep
/build-hosting/
/config/hosting.php

# Credentials and local configuration.
.env
.env.*
!.env.example

# Editors and operating-system files.
.vscode/
.idea/
.DS_Store
Thumbs.db
*.tmp
__pycache__/
*.py[cod]

# Expiring administrator-only network diagnostics.
/config/diagnostics-admin.php
/config/diagnostics-last.json
/config/execution-gate.json
